# Copy to .env.local for development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Hosts
PUBLIC_HOST=andraspop.com
EDIT_HOST=edit.andraspop.com

# Editor password gate (long random string; server-only)
EDIT_PASSWORD=

# Supabase (set by the Vercel integration; the legacy anon/service_role keys are disabled)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=                # server-only, never NEXT_PUBLIC_

# Vercel Blob: Instagram covers are copied here because Instagram's image links expire.
# Set by Vercel when the store is connected; without it the site uses Instagram's links directly.
BLOB_READ_WRITE_TOKEN=

# YouTube Data API v3 key: publish dates, durations and view counts. Without it, titles come from oEmbed.
YOUTUBE_API_KEY=

# Platform sync (M3)
YOUTUBE_CHANNEL_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
CRON_SECRET=                        # Vercel Cron sends this as a bearer token
