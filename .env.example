# Copy to .env.local for development. Set the same keys in Vercel → Project → Settings → Environment Variables.

# Hosts
PUBLIC_HOST=andraspop.com
EDIT_HOST=edit.andraspop.com

# Editor password gate (long random string; server-only)
EDIT_PASSWORD=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, never NEXT_PUBLIC_

# Platform sync (M3)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
CRON_SECRET=                        # Vercel Cron sends this as a bearer token
